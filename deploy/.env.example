POSTGRES_USER=sanitas
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=sanitas
# Porta locale (127.0.0.1) su cui raggiungere Postgres da un client esterno (es. DBeaver).
# Cambiala se hai già un Postgres locale sulla 5432.
POSTGRES_HOST_PORT=5432

# Porta locale su cui raggiungere il servizio shifts (http://localhost:<porta>).
# Cambiala se la 8080 è già occupata — ricorda di aggiornare anche
# VITE_SHIFTS_API_URL in web/.env se il frontend gira in locale.
SHIFTS_HOST_PORT=8080

# Origine consentita per le richieste CORS del frontend (in produzione: dominio pubblico dell'app web)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- registry ---
# Nessun Postgres separato: registry condivide lo stesso database di shifts,
# in un proprio schema (vedi docs/adr/0014) — solo la porta esposta lato host cambia.
REGISTRY_HOST_PORT=8090

# Chiave privata JWT (RS256): genera con `openssl genrsa -out jwt_private_key.pem 2048`
# nella cartella services/registry (mai committata) — cambia questo path se la metti altrove.
JWT_PRIVATE_KEY_HOST_PATH=../services/registry/jwt_private_key.pem

# Cartella di configurazione del comitato (ruoli, branding, ecc.) — chi forka
# punta alla propria config/<slug>/ invece di config/pavullo.
COMMITTEE_CONFIG_DIR=../config/pavullo

# Base dell'URL di attivazione: sempre restituito da POST /v1/utenti come
# ripiego, oltre ad essere spedito via email se SMTP_* sotto è configurato
# (vedi docs/adr/0023).
INVITE_URL_BASE=http://localhost:5173/attiva

# Base dell'URL di reimpostazione password inviato via email (vedi
# docs/adr/0024). Nessun ripiego nella risposta API qui: la richiesta è
# sempre 204, per non rivelare se l'account esiste.
PASSWORD_RESET_URL_BASE=http://localhost:5173/#/reset-password

# Credenziali del primo amministratore, usate solo se la tabella users di
# registry è vuota al primo avvio.
INITIAL_ADMIN_EMAIL=admin@example.org
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=cambiami

# SMTP per l'invio automatico dell'email di invito (vedi docs/adr/0023).
# Tutti opzionali: se SMTP_HOST è vuoto l'invio resta disabilitato, nessuna
# rottura per chi non lo configura. Per Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_USERNAME=il tuo indirizzo, SMTP_PASSWORD=una "app password" da
# https://myaccount.google.com/apppasswords (non la password normale).
# SMTP_PORT=587 (STARTTLS) o 465 (TLS implicito) vanno bene entrambe.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Token del tunnel Cloudflare (dashboard Cloudflare Zero Trust > Networks > Tunnels),
# necessario solo in produzione (profilo "prod").
CLOUDFLARE_TUNNEL_TOKEN=
