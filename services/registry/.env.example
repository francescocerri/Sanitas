PORT=8080
DATABASE_URL=postgres://registry:devlocalpassword@localhost:5433/registry?sslmode=disable&search_path=registry
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Percorso della chiave privata RSA usata per firmare i JWT (RS256).
# Generarla una tantum con: openssl genrsa -out jwt_private_key.pem 2048
# Non va mai committata (vedi .dockerignore/.gitignore).
JWT_PRIVATE_KEY_PATH=./jwt_private_key.pem

# File dei ruoli (dati per-comitato, vedi docs/adr/0012) applicato all'avvio.
ROLES_SEED_PATH=../../config/pavullo/registry/roles.json

# Base dell'URL di attivazione: sempre presente nella risposta di
# POST /v1/utenti come ripiego, oltre ad essere spedito via email se SMTP_*
# sotto è configurato (vedi docs/adr/0023).
INVITE_URL_BASE=http://localhost:5173/attiva

# Base dell'URL di reimpostazione password inviato via email quando un
# utente lo richiede (vedi docs/adr/0024). Nessun ripiego "restituito
# nella risposta API" qui: la risposta di POST /v1/password/reset/request
# è sempre 204 a prescindere, per non rivelare se l'account esiste.
PASSWORD_RESET_URL_BASE=http://localhost:5173/#/reset-password

# Credenziali del primo amministratore, usate solo se la tabella users è
# vuota al primo avvio (nessun endpoint di setup pubblico, vedi docs/adr/0013).
INITIAL_ADMIN_EMAIL=admin@example.org
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=cambiami

# SMTP per l'invio automatico dell'email di invito (vedi docs/adr/0023).
# Tutti opzionali: se SMTP_HOST è vuoto l'invio resta disabilitato e il
# link di attivazione va condiviso a mano come prima di questa funzionalità
# — nessun fork è costretto a configurare Gmail per continuare a funzionare.
# Per Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=il tuo indirizzo,
# SMTP_PASSWORD=una "app password" generata da https://myaccount.google.com/apppasswords
# (non la password normale dell'account). SMTP_PORT=587 (STARTTLS, default
# qui sotto) o 465 (TLS implicito) vanno bene entrambe con Gmail — il tipo
# di TLS si sceglie da sola in base al numero di porta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# File col mittente da mostrare nelle email (dato del comitato, non un
# segreto, vedi docs/adr/0023).
EMAIL_CONFIG_PATH=../../config/pavullo/registry/email.json
